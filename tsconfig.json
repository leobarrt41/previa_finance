{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["packages/**/*", "apps/**/*", "docs/**/*"],
  "exclude": ["node_modules", "dist"]
}
