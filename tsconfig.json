{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
  "moduleResolution": "bundler",
  "jsx": "react-jsx",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
  "types": ["node", "jest"]
  },
  "include": ["packages/**/*", "apps/**/*", "docs/**/*", "types/**/*"],
  "allowImportingTsExtensions": true,
  "exclude": ["node_modules", "dist"]
}
